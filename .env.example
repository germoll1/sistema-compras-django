# Copiar este archivo como .env y completar los valores locales.
# Django carga .env automáticamente; las variables del sistema tienen prioridad.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3307
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
MERCADOPAGO_SANDBOX=1
TRANSFERENCIA_ALIAS=TIENDA.DEMO.COMPRAS
TRANSFERENCIA_EMAIL=comprobantes@tienda.example
